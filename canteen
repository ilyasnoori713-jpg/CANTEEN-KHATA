                    <label class="block text-xs font-semibold text-gray-700 mb-1">Product Name</label>
                    <input type="text" id="modal-prod-name" required class="w-full p-2 text-xs border border-gray-300 rounded-lg">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Medium Size Price (Rs.)</label>
                    <input type="number" id="modal-prod-med" required min="0" class="w-full p-2 text-xs border border-gray-300 rounded-lg">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Large Size Price (Rs.)</label>
                    <input type="number" id="modal-prod-lrg" required min="0" class="w-full p-2 text-xs border border-gray-300 rounded-lg">
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" onclick="closeModal('modal-product')" class="px-3 py-1.5 bg-gray-200 rounded-lg text-xs font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-1.5 bg-canteen-700 text-white rounded-lg text-xs font-bold hover:bg-canteen-800">Save Price</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 4: FIREBASE CONFIG SETTINGS -->
    <div id="modal-config" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-5 space-y-4 shadow-2xl">
            <h3 class="text-lg font-bold text-canteen-800">Firebase Cloud Database Setup</h3>
            <p class="text-xs text-gray-600">Paste your Firebase Project Web Configuration JSON below to synchronize all 3 Android devices real-time.</p>
            <textarea id="firebase-json-input" rows="7" placeholder='{
  "apiKey": "AIzaSy...",
  "authDomain": "mycanteen.firebaseapp.com",
  "projectId": "mycanteen",
  "storageBucket": "mycanteen.appspot.com",
  "messagingSenderId": "...",
  "appId": "..."
}' class="w-full font-mono text-xs p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-canteen-600"></textarea>
            <div class="flex justify-end space-x-2">
                <button type="button" onclick="closeModal('modal-config')" class="px-3 py-1.5 bg-gray-200 rounded-lg text-xs font-bold">Cancel</button>
                <button type="button" onclick="saveFirebaseCredentials()" class="px-4 py-1.5 bg-canteen-700 text-white rounded-lg text-xs font-bold hover:bg-canteen-800">Save Config</button>
            </div>
        </div>
    </div>

    <!-- Embedded Application Logic -->
    <script>
        // Storage Keys
        const KEY_CONFIG = 'ck_firebase_cfg';
        const KEY_CUSTOMERS = 'ck_local_cust';
        const KEY_PRODUCTS = 'ck_local_prod';
        const KEY_ORDERS = 'ck_local_ord';

        let db = null;
        let auth = null;
        let currentUser = null;

        let customers = [];
        let products = [];
        let orders = [];

        // Fixed Pre-set Products
        const INITIAL_PRODUCTS = [
            { id: 'p1', name: 'Banana Shake', mediumPrice: 100, largePrice: 150 },
            { id: 'p2', name: 'Banana with Dates Shake', mediumPrice: 150, largePrice: 200 },
            { id: 'p3', name: 'Dates Shake', mediumPrice: 200, largePrice: 250 }
        ];

        // Initialization
        window.addEventListener('DOMContentLoaded', () => {
            initFirebase();
            loadLocalCache();
            setupNetworkMonitor();
            registerPWA();
        });

        function initFirebase() {
            const rawCfg = localStorage.getItem(KEY_CONFIG);
            if (rawCfg) {
                try {
                    const cfg = JSON.parse(rawCfg);
                    if (!firebase.apps.length) firebase.initializeApp(cfg);
                    db = firebase.firestore();
                    auth = firebase.auth();

                    db.enablePersistence({ synchronizeTabs: true }).catch(() => {});

                    auth.onAuthStateChanged(user => {
                        if (user) {
                            currentUser = user;
                            document.getElementById('screen-login').classList.add('hidden');
                            document.getElementById('screen-dashboard').classList.remove('hidden');
                            document.getElementById('auth-user-bar').classList.remove('hidden');
                            document.getElementById('current-user-email').innerText = user.email;
                            
                            checkAdminRole();
                            syncCloudData();
                        } else {
                            currentUser = null;
                            document.getElementById('screen-login').classList.remove('hidden');
                            document.getElementById('screen-dashboard').classList.add('hidden');
                            document.getElementById('auth-user-bar').classList.add('hidden');
                        }
                    });
                    document.getElementById('firebase-alert').classList.add('hidden');
                } catch (e) {
                    document.getElementById('firebase-alert').classList.remove('hidden');
                }
            } else {
                document.getElementById('firebase-alert').classList.remove('hidden');
            }
        }

        // Authentication logic
        async function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim();
            const pass = document.getElementById('login-password').value;

            if (!auth) {
                alert('Firebase credentials not set! Click "Setup Firebase Credentials" below.');
                return;
            }

            try {
                await auth.signInWithEmailAndPassword(email, pass);
            } catch (err) {
                if (err.code === 'auth/user-not-found') {
                    try {
                        await auth.createUserWithEmailAndPassword(email, pass);
                        alert('New account registered and signed in!');
                    } catch (signupErr) {
                        alert('Sign up error: ' + signupErr.message);
                    }
                } else {
                    alert('Login failed: ' + err.message);
                }
            }
        }

        function handleLogout() {
            if (auth) auth.signOut();
        }

        function checkAdminRole() {
            const isAdmin = currentUser && (currentUser.email.includes('admin') || currentUser.email === 'admin@canteen.com');
            document.querySelectorAll('.admin-only').forEach(el => {
                if (isAdmin) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
        }

        // Real-time Cloud Synchronization
        function syncCloudData() {
            if (!db) return;

            db.collection('customers').onSnapshot(snap => {
                customers = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                localStorage.setItem(KEY_CUSTOMERS, JSON.stringify(customers));
                renderCustomerSelect();
                renderCustomersTable();
            });

            db.collection('products').onSnapshot(snap => {
                if (snap.empty) {
                    INITIAL_PRODUCTS.forEach(p => db.collection('products').doc(p.id).set(p));
                } else {
                    products = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                    localStorage.setItem(KEY_PRODUCTS, JSON.stringify(products));
                    renderProductSelect();
                    renderProductsTable();
                }
            });

            db.collection('orders').orderBy('createdAt', 'desc').onSnapshot(snap => {
                orders = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                localStorage.setItem(KEY_ORDERS, JSON.stringify(orders));
                renderOrdersTable();
                renderCustomersTable();
            });
        }

        function loadLocalCache() {
            customers = JSON.parse(localStorage.getItem(KEY_CUSTOMERS)) || [];
            products = JSON.parse(localStorage.getItem(KEY_PRODUCTS)) || INITIAL_PRODUCTS;
            orders = JSON.parse(localStorage.getItem(KEY_ORDERS)) || [];
            renderCustomerSelect();
            renderProductSelect();
            renderProductsTable();
            renderOrdersTable();
            renderCustomersTable();
        }

        // Navigation UI Tabs
        function showTab(tabId) {
            ['new-order', 'orders', 'customers', 'settings'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                document.getElementById(`tab-btn-${t}`).classList.remove('active-tab');
            });
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-btn-${tabId}`).classList.add('active-tab');
        }

        // Customer Logic
        function generateCustId() {
            return 'CUST-' + Math.floor(1000 + Math.random() * 9000);
        }

        function openCustomerModal() {
            document.getElementById('modal-cust-name').value = '';
            document.getElementById('modal-cust-phone').value = '';
            document.getElementById('modal-customer').classList.remove('hidden');
        }

        async function saveCustomer(e) {
            e.preventDefault();
            const name = document.getElementById('modal-cust-name').value.trim();
            const phone = document.getElementById('modal-cust-phone').value.trim();

            const existing = customers.find(c => c.phone === phone);
            if (existing) {
                alert(`Customer already exists with ID: ${existing.customerId}`);
                closeModal('modal-customer');
                return;
            }

            const payload = {
                customerId: generateCustId(),
                name,
                phone,
                createdAt: new Date().toISOString()
            };

            if (db) {
                await db.collection('customers').add(payload);
            } else {
                customers.push(payload);
                localStorage.setItem(KEY_CUSTOMERS, JSON.stringify(customers));
                renderCustomerSelect();
                renderCustomersTable();
            }
            closeModal('modal-customer');
        }

        function renderCustomerSelect() {
            const select = document.getElementById('select-customer');
            select.innerHTML = '<option value="">-- Choose Existing Customer --</option>';
            customers.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.customerId;
                opt.textContent = `${c.name} (${c.phone}) - [${c.customerId}]`;
                select.appendChild(opt);
            });
        }

        function handleCustomerSelect(val) {
            const card = document.getElementById('selected-customer-card');
            if (!val) {
                card.classList.add('hidden');
                return;
            }
            const cust = customers.find(c => c.customerId === val);
            if (cust) {
                document.getElementById('card-cust-name').innerText = cust.name;
                document.getElementById('card-cust-phone').innerText = cust.phone;
                document.getElementById('card-cust-id').innerText = cust.customerId;
                card.classList.remove('hidden');
            }
        }

        function renderCustomersTable() {
            const tbody = document.getElementById('table-customers-body');
            const term = document.getElementById('search-customers').value.toLowerCase();
            tbody.innerHTML = '';

            const filtered = customers.filter(c =>
                c.name.toLowerCase().includes(term) ||
                c.phone.includes(term) ||
                c.customerId.toLowerCase().includes(term)
            );

            filtered.forEach(c => {
                const custOrders = orders.filter(o => o.customerId === c.customerId);
                const unpaid = custOrders.filter(o => o.paymentStatus === 'Unpaid').reduce((s, o) => s + (Number(o.totalPrice) || 0), 0);

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2.5 font-mono font-bold text-canteen-800">${c.customerId}</td>
                    <td class="p-2.5 font-medium">${c.name}</td>
                    <td class="p-2.5 text-gray-500">${c.phone}</td>
                    <td class="p-2.5 font-semibold">${custOrders.length}</td>
                    <td class="p-2.5 font-bold ${unpaid > 0 ? 'text-rose-600' : 'text-emerald-600'}">Rs. ${unpaid}</td>
                    <td class="p-2.5 text-center">
                        <button onclick="viewCustomerProfile('${c.customerId}')" class="bg-canteen-100 text-canteen-800 font-bold px-2 py-1 rounded">Profile</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function viewCustomerProfile(cid) {
            const cust = customers.find(c => c.customerId === cid);
            if (!cust) return;

            document.getElementById('prof-display-name').innerText = cust.name;
            document.getElementById('prof-display-info').innerText = `Phone: ${cust.phone} | ID: ${cust.customerId}`;

            const custOrders = orders.filter(o => o.customerId === cid);
            const total = custOrders.reduce((s, o) => s + Number(o.totalPrice || 0), 0);
            const unpaid = custOrders.filter(o => o.paymentStatus === 'Unpaid').reduce((s, o) => s + Number(o.totalPrice || 0), 0);

            document.getElementById('prof-display-total').innerText = `Rs. ${total}`;
            document.getElementById('prof-display-unpaid').innerText = `Rs. ${unpaid}`;

            const tbody = document.getElementById('prof-table-orders-body');
            tbody.innerHTML = '';
            custOrders.forEach(o => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2 font-mono">${o.orderNo}</td>
                    <td class="p-2">${o.date}</td>
                    <td class="p-2">${o.productName} (${o.size}) x${o.quantity}</td>
                    <td class="p-2 font-bold">Rs. ${o.totalPrice}</td>
                    <td class="p-2 font-bold ${o.paymentStatus === 'Paid' ? 'text-emerald-600' : 'text-rose-600'}">${o.paymentStatus}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('modal-profile').classList.remove('hidden');
        }

        // Product Menu Logic
        function renderProductSelect() {
            const select = document.getElementById('input-product');
            select.innerHTML = '';
            products.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.name;
                opt.textContent = p.name;
                select.appendChild(opt);
            });
            updateOrderCalculations();
        }

        function updateOrderCalculations() {
            const pName = document.getElementById('input-product').value;
            const size = document.getElementById('input-size').value;
            const qty = parseInt(document.getElementById('input-qty').value) || 1;

            const prod = products.find(p => p.name === pName);
            if (prod) {
                const unitPrice = size === 'Medium' ? Number(prod.mediumPrice) : Number(prod.largePrice);
                document.getElementById('display-unit-price').value = `Rs. ${unitPrice}`;
                document.getElementById('display-total-price').value = `Rs. ${unitPrice * qty}`;
            }
        }

        function renderProductsTable() {
            const tbody = document.getElementById('table-products-body');
            tbody.innerHTML = '';
            products.forEach(p => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2.5 font-bold">${p.name}</td>
                    <td class="p-2.5">Rs. ${p.mediumPrice}</td>
                    <td class="p-2.5">Rs. ${p.largePrice}</td>
                    <td class="p-2.5 text-center admin-only hidden">
                        <button onclick="editProduct('${p.id}')" class="bg-amber-500 text-white font-bold px-2 py-0.5 rounded text-[10px]">Edit</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            checkAdminRole();
        }

        function openProductModal() {
            document.getElementById('modal-prod-title').innerText = 'Add New Menu Item';
            document.getElementById('modal-prod-id').value = '';
            document.getElementById('modal-prod-name').value = '';
            document.getElementById('modal-prod-med').value = '';
            document.getElementById('modal-prod-lrg').value = '';
            document.getElementById('modal-product').classList.remove('hidden');
        }

        function editProduct(id) {
            const p = products.find(item => item.id === id);
            if (!p) return;
            document.getElementById('modal-prod-title').innerText = 'Edit Menu Item';
            document.getElementById('modal-prod-id').value = p.id;
            document.getElementById('modal-prod-name').value = p.name;
            document.getElementById('modal-prod-med').value = p.mediumPrice;
            document.getElementById('modal-prod-lrg').value = p.largePrice;
            document.getElementById('modal-product').classList.remove('hidden');
        }

        async function saveProduct(e) {
            e.preventDefault();
            const id = document.getElementById('modal-prod-id').value;
            const name = document.getElementById('modal-prod-name').value.trim();
            const mediumPrice = Number(document.getElementById('modal-prod-med').value);
            const largePrice = Number(document.getElementById('modal-prod-lrg').value);

            const payload = { name, mediumPrice, largePrice };

            if (db) {
                if (id) await db.collection('products').doc(id).update(payload);
                else await db.collection('products').add(payload);
            } else {
                if (id) {
                    const idx = products.findIndex(p => p.id === id);
                    if (idx !== -1) products[idx] = { id, ...payload };
                } else {
                    products.push({ id: 'p_' + Date.now(), ...payload });
                }
                localStorage.setItem(KEY_PRODUCTS, JSON.stringify(products));
                renderProductSelect();
                renderProductsTable();
            }
            closeModal('modal-product');
        }

        // Order Recording Logic
        async function submitNewOrder(e) {
            e.preventDefault();
            const custId = document.getElementById('select-customer').value;
            if (!custId) {
                alert('Please select a customer first.');
                return;
            }

            const cust = customers.find(c => c.customerId === custId);
            const pName = document.getElementById('input-product').value;
            const size = document.getElementById('input-size').value;
            const qty = parseInt(document.getElementById('input-qty').value);
            
            const prod = products.find(p => p.name === pName);
            const unitPrice = size === 'Medium' ? Number(prod.mediumPrice) : Number(prod.largePrice);
            const totalPrice = unitPrice * qty;

            const paymentStatus = document.getElementById('input-payment-status').value;
            const deliveryStatus = document.getElementById('input-delivery-status').value;

            const order = {
                orderNo: 'ORD-' + Math.floor(100000 + Math.random() * 900000),
                date: new Date().toLocaleDateString(),
                createdAt: new Date().toISOString(),
                customerId: cust.customerId,
                customerName: cust.name,
                productName: pName,
                size,
                quantity: qty,
                unitPrice,
                totalPrice,
                paymentStatus,
                deliveryStatus,
                userEmail: currentUser ? currentUser.email : 'Local User'
            };

            if (db) {
                await db.collection('orders').add(order);
            } else {
                orders.unshift(order);
                localStorage.setItem(KEY_ORDERS, JSON.stringify(orders));
                renderOrdersTable();
                renderCustomersTable();
            }

            alert('Order recorded successfully!');
            document.getElementById('form-new-order').reset();
            document.getElementById('selected-customer-card').classList.add('hidden');
            updateOrderCalculations();
        }

        function renderOrdersTable() {
            const tbody = document.getElementById('table-orders-body');
            const term = document.getElementById('search-orders').value.toLowerCase();
            tbody.innerHTML = '';

            const filtered = orders.filter(o =>
                o.customerName.toLowerCase().includes(term) ||
                o.customerId.toLowerCase().includes(term) ||
                o.orderNo.toLowerCase().includes(term) ||
                o.date.includes(term)
            );

            let totalRev = 0;
            let unpaidRev = 0;

            filtered.forEach(o => {
                totalRev += Number(o.totalPrice || 0);
                if (o.paymentStatus === 'Unpaid') unpaidRev += Number(o.totalPrice || 0);

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2.5 font-mono font-bold">${o.orderNo}</td>
                    <td class="p-2.5 text-gray-500">${o.date}</td>
                    <td class="p-2.5 font-medium">${o.customerName} <span class="text-[10px] text-gray-400">(${o.customerId})</span></td>
                    <td class="p-2.5">${o.productName} <span class="text-canteen-700 font-bold">(${o.size})</span> x${o.quantity}</td>
                    <td class="p-2.5 font-bold text-canteen-900">Rs. ${o.totalPrice}</td>
                    <td class="p-2.5">
                        <button onclick="togglePayment('${o.id}')" class="px-2 py-0.5 rounded font-bold ${o.paymentStatus === 'Paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                            ${o.paymentStatus} 🔄
                        </button>
                    </td>
                    <td class="p-2.5">
                        <button onclick="toggleDelivery('${o.id}')" class="px-2 py-0.5 rounded font-bold ${o.deliveryStatus === 'Delivered' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'}">
                            ${o.deliveryStatus} 🔄
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('stat-total-orders').innerText = filtered.length;
            document.getElementById('stat-total-revenue').innerText = `Rs. ${totalRev}`;
            document.getElementById('stat-unpaid-balance').innerText = `Rs. ${unpaidRev}`;
        }

        async function togglePayment(id) {
            const o = orders.find(item => item.id === id);
            if (!o) return;
            const newStatus = o.paymentStatus === 'Paid' ? 'Unpaid' : 'Paid';

            if (db && o.id) {
                await db.collection('orders').doc(o.id).update({ paymentStatus: newStatus });
            } else {
                o.paymentStatus = newStatus;
                localStorage.setItem(KEY_ORDERS, JSON.stringify(orders));
                renderOrdersTable();
                renderCustomersTable();
            }
        }

        async function toggleDelivery(id) {
            const o = orders.find(item => item.id === id);
            if (!o) return;
            const newStatus = o.deliveryStatus === 'Delivered' ? 'Pending' : 'Delivered';

            if (db && o.id) {
                await db.collection('orders').doc(o.id).update({ deliveryStatus: newStatus });
            } else {
                o.deliveryStatus = newStatus;
                localStorage.setItem(KEY_ORDERS, JSON.stringify(orders));
                renderOrdersTable();
            }
        }

        // Backup & JSON Handling
        function exportDataJSON() {
            const backup = { customers, products, orders, exportedAt: new Date().toISOString() };
            const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `canteen_khata_backup_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
        }

        function importDataJSON(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = async (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    if (data.customers && data.products && data.orders) {
                        if (db) {
                            for (const c of data.customers) await db.collection('customers').add(c);
                            for (const p of data.products) await db.collection('products').add(p);
                            for (const o of data.orders) await db.collection('orders').add(o);
                        }
                        localStorage.setItem(KEY_CUSTOMERS, JSON.stringify(data.customers));
                        localStorage.setItem(KEY_PRODUCTS, JSON.stringify(data.products));
                        localStorage.setItem(KEY_ORDERS, JSON.stringify(data.orders));
                        loadLocalCache();
                        alert('Data successfully restored!');
                    }
                } catch (err) {
                    alert('Invalid Backup JSON File.');
                }
            };
            reader.readAsText(file);
        }

        // Configuration helpers
        function openConfigModal() {
            document.getElementById('modal-config').classList.remove('hidden');
        }

        function saveFirebaseCredentials() {
            const text = document.getElementById('firebase-json-input').value.trim();
            try {
                const parsed = JSON.parse(text);
                localStorage.setItem(KEY_CONFIG, JSON.stringify(parsed));
                alert('Firebase configuration saved! Reloading application...');
                window.location.reload();
            } catch (err) {
                alert('Invalid JSON formatting in credentials.');
            }
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function setupNetworkMonitor() {
            const badge = document.getElementById('network-status');
            function update() {
                if (navigator.onLine) {
                    badge.innerText = 'Online Sync';
                    badge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-600 text-white';
                } else {
                    badge.innerText = 'Offline Mode';
                    badge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-amber-600 text-white';
                }
            }
            window.addEventListener('online', update);
            window.addEventListener('offline', update);
            update();
        }

        function registerPWA() {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('sw.js').catch(() => {});
            }
        }
    </script>
</body>
